# 本地启动：复制为 .env.local，填写所有值；.env.local 已被 Git 忽略。
# IDEA：在 LowcodeApplication 的「环境变量」中加载 .env.local 的绝对路径，
# 或逐项添加下列变量。不要把文件路径填进「有效配置文件 / Active profiles」。
# 终端：在 lowcode-service 目录执行 set -a; source .env.local; set +a
# 然后执行 ./mvnw spring-boot:run。Spring Boot 不会自动读取 .env.local。
# 值含空格、分号等 shell 特殊字符时使用单引号包围。

# 本服务端口与 Nacos 地址；地址格式 host:port，不带 http://。
FORGE_SERVICE_PORT=
FORGE_NACOS_ADDR=

# 平台提供的完整 PostgreSQL JDBC URL（包含数据库名）。
# 运行账号与迁移账号分别填写，运行账号不能使用 postgres 等超级用户。
FORGE_DB_URL=
FORGE_DB_USER=
FORGE_DB_PASSWORD=
FORGE_DB_MIGRATOR_USER=
FORGE_DB_MIGRATOR_PASSWORD=
FORGE_DB_SCHEMA=

# 平台共享 Redis 与 RocketMQ Proxy 的 gRPC 地址。
FORGE_REDIS_HOST=
FORGE_REDIS_PORT=
FORGE_ROCKETMQ_ENDPOINTS=

# Tenant Realm issuer 须与 Token 一致；JWKS 和 IAM URI 使用服务直连地址。
FORGE_SECURITY_ISSUER=
FORGE_SECURITY_JWK_SET_URI=
FORGE_IAM_URI=

# 本服务专属 Manifest 上报令牌与运维令牌（两者不同）。
# 分别与 IAM 的服务登记配置、platform 的 forge.platform.ops.tokens.lowcode-service 一致。
FORGE_MANIFEST_TOKEN=
FORGE_OPS_TOKEN=

# 按实际平台内网填写禁止访问的 CIDR，多个网段用逗号分隔（ADR-0002）。
LOWCODE_DATASOURCE_BLOCKED_NETWORKS=
# Base64 编码的 32 字节 AES 密钥；已有数据时沿用原密钥。
# 新环境可执行 openssl rand -base64 32 生成，并只保存在 .env.local。
LOWCODE_DATASOURCE_ENCRYPTION_KEY=

# 对象存储（必填）：浏览器可访问的 S3 兼容地址、预建 bucket 和服务密钥。
# bucket 的 CORS 须允许 Sub-App 所在源的 PUT/GET 与签名所需请求头。
FORGE_STORAGE_ENDPOINT=
FORGE_STORAGE_BUCKET=
FORGE_STORAGE_ACCESS_KEY=
FORGE_STORAGE_SECRET_KEY=
