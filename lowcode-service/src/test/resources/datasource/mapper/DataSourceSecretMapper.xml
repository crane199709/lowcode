<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.saasforge.lowcode.datasource.mapper.DataSourceSecretMapper">
    <select id="selectSecrets" resultType="map">
        SELECT password_encrypted, api_header_value_encrypted FROM data_sources
        WHERE id = #{id} AND NOT deleted
    </select>
</mapper>
