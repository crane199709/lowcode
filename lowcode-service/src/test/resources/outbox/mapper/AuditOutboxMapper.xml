<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.saasforge.lowcode.outbox.mapper.AuditOutboxMapper">
    <select id="selectAuditPayloads" resultType="string">
        SELECT CAST(payload AS text) FROM forge_outbox
        WHERE topic = 'forge-audit'
        ORDER BY id
    </select>
</mapper>
